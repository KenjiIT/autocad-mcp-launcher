**/.venv/
**/__pycache__/
**/.pytest_cache/
/dist/installer-payload/
/dist/AutoCAD-MCP-Launcher-Setup-*.exe
/dist/AutoCAD-MCP-Launcher-Setup-*.exe.sha256
/dist/*.sha256
launcher/logs/
autocad-beiming-mcp-custom/.local-data/
autocad-beiming-mcp-custom/output/

launcher/state/

# Autodesk sample blocks extracted into the block library (not ours to redistribute)
blocks/*.dwg
blocks/*.dxf
# Kho riêng (sub-folders of blocks/): third-party packs, local only
blocks/*/

# Team key embedded at release build time (see scripts/write_team_key.py); never commit
launcher/team_key.dat

# Estimating database: compiled from a commercial package, distributed privately (see launcher/dutoan_data.py)
du-toan-mcp/data/
du-toan-mcp/*.db

# okf-scan context receipts
.harness/metrics/context-receipts.jsonl
harness/metrics/cost-by-session.json

# mem-rank local memory store
.harness/metrics/memory.jsonl

# Đầu ra làm việc (bảng bóc khối lượng...), không phải mã nguồn
/output/

# Dữ liệu và ghi chú dự án, không công khai
/reports/
/research_notes/
/review_1852-T3-S-405/
/ErrorReports/
/tmp/
/apartment-viewer/
/T3_dam_can_xac_nhan_dau_mut.csv
/luu y thiet ke mat bang chung cu.md

# Công cụ và tri thức nội bộ (overstack), không công khai
/.llmwiki/
/.harness/

