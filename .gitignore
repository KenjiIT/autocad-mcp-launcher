**/.venv/
**/__pycache__/
**/.pytest_cache/
/dist/installer-payload/
/dist/AutoCAD-MCP-Launcher-Setup-*.exe
/dist/AutoCAD-MCP-Launcher-Setup-*.exe.sha256
/dist/*.sha256
launcher/logs/
autocad-beiming-mcp-custom/.local-data/
autocad-beiming-mcp-custom/output/

launcher/state/

# Autodesk sample blocks extracted into the block library (not ours to redistribute)
blocks/*.dwg
blocks/*.dxf
# Kho riêng (sub-folders of blocks/): third-party packs, local only
blocks/*/

# Team key embedded at release build time (see scripts/write_team_key.py); never commit
launcher/team_key.dat

# Estimating database: compiled from a commercial package, distributed privately (see launcher/dutoan_data.py)
du-toan-mcp/data/
du-toan-mcp/*.db
