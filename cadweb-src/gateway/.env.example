# Bản LOCAL: không có đăng nhập/tài khoản, không có mô hình "máy CAD từ xa".
# Gateway gọi thẳng MCP của chính máy này, phục vụ bởi AutoCAD MCP Launcher ở 127.0.0.1:8764.

# Địa chỉ gateway của AutoCAD MCP Launcher (đổi nếu launcher không dùng cổng mặc định).
LOCAL_MCP_BASE=http://127.0.0.1:8764
# Danh sách MCP của máy này: "key:Tên hiện,key2:Tên 2". Để trống dùng mặc định (beiming, puran, dutoan).
# Thêm litebim/litecad vào đây nếu máy có cài và đã bật MCP tương ứng trong launcher.
LOCAL_MCP=

# Chỉ tool khớp mới được gọi (phân tách bằng dấu phẩy, để trống = cho phép tất cả).
ALLOWED_TOOLS=

PORT=8788
HOST=127.0.0.1
# Origin được phép gọi (frontend của web local). Dev: http://localhost:5174
CORS_ORIGIN=http://localhost:5174

# Khóa API Anthropic, chỉ cần khi CHAT_ENGINE=api (chế độ Claude CLI dùng `claude auth login` của máy, không cần key ở đây).
ANTHROPIC_API_KEY=
# cli (mặc định, dùng Claude CLI đã đăng nhập trên máy) | api (gọi thẳng Anthropic API) | codex (dùng Codex CLI)
CHAT_ENGINE=cli
CHAT_MODEL=claude-sonnet-5-5
CHAT_MAX_STEPS=20
# Đường dẫn Claude CLI / Codex CLI nếu không nằm trên PATH.
CLAUDE_BIN=claude
CODEX_BIN=codex
